/* The board's few layout classes; the look itself is set from code (Game/Art.cs, MatchScreen.cs) with the web's art. */
.screen { flex-grow: 1; background-color: rgb(8, 19, 31); }
.page { position: absolute; left: 0; top: 0; right: 0; bottom: 0; padding: 12px 16px 14px; }
.hud { flex-direction: row; justify-content: space-between; align-items: flex-start; margin-bottom: 6px; }
.board { flex-direction: row; justify-content: center; }
.column { margin: 0 8px; }
.log { padding: 8px 10px; border-radius: 8px; background-color: rgba(10, 22, 38, 0.92); border-width: 2px; border-color: rgb(138, 106, 20); }
.hand { align-items: center; margin-bottom: 0; }
.result { position: absolute; left: 30%; right: 30%; top: 32%; padding: 24px; border-radius: 12px; border-width: 2px; border-color: rgb(246, 215, 122); background-color: rgb(15, 31, 51); align-items: center; }
